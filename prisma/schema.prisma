generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Content Type Definitions
model CollectionType {
  id          String   @id @default(cuid())
  name        String   @unique
  displayName String
  description String?
  fields      Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SingleType {
  id          String   @id @default(cuid())
  name        String   @unique
  displayName String
  description String?
  fields      Json
  data        Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Component {
  id          String   @id @default(cuid())
  name        String   @unique
  displayName String
  category    String
  fields      Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Media Library
model Media {
  id              String   @id @default(cuid())
  name            String
  alternativeText String?
  caption         String?
  url             String
  mime            String
  size            Int
  width           Int?
  height          Int?
  ext             String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("media")
}

// Dynamic Collection Types

model Blogs {
  id         String    @id @default(cuid())
  name       String?
  content    String?
  thumb      Json?
  cktest     String?
  blogCateId String?
  blogCate   BlogCate? @relation("BlogsToBlogCate", fields: [blogCateId], references: [id])
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@map("blogs")
}

model BlogCate {
  id        String   @id @default(cuid())
  name      String?
  desc      String?
  blogss    Blogs[]  @relation("BlogsToBlogCate")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("blog_cate")
}

model News {
  id         String    @id @default(cuid())
  name       String?
  desc       String?
  newsCateId String?
  newsCate   NewsCate? @relation("NewsToNewsCate", fields: [newsCateId], references: [id])
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@map("news")
}

model NewsCate {
  id        String   @id @default(cuid())
  name      String?
  email     String?
  newss     News[]   @relation("NewsToNewsCate")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("news_cate")
}
