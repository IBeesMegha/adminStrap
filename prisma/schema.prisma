generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  password  String
  name      String
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  roleId    String?
  sessions  Session[]
  role         Role?          @relation(fields: [roleId], references: [id])
  chatSessions ChatSession[]

  @@index([roleId])
  @@map("users")
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  slug        String           @unique
  description String?
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  users       User[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(cuid())
  name        String           @unique
  slug        String           @unique
  module      String
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  refreshToken String   @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshToken])
  @@map("sessions")
}

model CollectionType {
  id          String   @id @default(cuid())
  name        String   @unique
  displayName String
  description String?
  fields      Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SingleType {
  id                 String   @id @default(cuid())
  name               String
  displayName        String
  description        String?
  fields             Json
  data               Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  lang               String
  localeStatus       String   @default("published")
  translationGroupId String

  @@unique([name, lang])
  @@index([translationGroupId])
  @@index([lang])
}

model Component {
  id          String           @id @default(cuid())
  name        String           @unique
  displayName String
  category    String
  fields      Json
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  entries     ComponentEntry[]
}

model ComponentEntry {
  id          String    @id @default(cuid())
  componentId String
  data        Json
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  component   Component @relation(fields: [componentId], references: [id], onDelete: Cascade)

  @@index([componentId])
  @@map("component_entries")
}

model Media {
  id              String   @id @default(cuid())
  name            String
  alternativeText String?
  caption         String?
  url             String
  mime            String
  size            Int
  width           Int?
  height          Int?
  ext             String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  folder          String?

  @@map("media")
}

model Language {
  id         String   @id @default(cuid())
  code       String   @unique
  name       String
  nativeName String?
  flag       String?
  isDefault  Boolean  @default(false)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("languages")
}

model KnowledgeSource {
  id           String           @id @default(cuid())
  name         String
  websiteUrl   String           @unique
  status       String           @default("pending")
  totalPages   Int              @default(0)
  lastCrawlAt  DateTime?
  errorMessage String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  totalChunks  Int              @default(0)
  chunks       KnowledgeChunk[]
  pages        KnowledgePage[]

  @@map("knowledge_sources")
}

model KnowledgePage {
  id               String           @id @default(cuid())
  sourceId         String
  url              String
  pageTitle        String?
  textContent      String
  htmlContent      String
  contentLength    Int              @default(0)
  crawlStatus      String           @default("discovered")
  errorMessage     String?
  lastCrawledAt    DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  lastProcessedAt  DateTime?
  processingStatus String           @default("pending")
  chunks           KnowledgeChunk[]
  media            KnowledgeMedia[]
  source           KnowledgeSource  @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, url])
  @@index([sourceId])
  @@index([url])
  @@index([processingStatus])
  @@map("knowledge_pages")
}

model KnowledgeChunk {
  id             String           @id @default(cuid())
  sourceId       String
  pageId         String
  chunkText      String
  chunkIndex     Int
  tokenCount     Int              @default(0)
  embedding      Float[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  sectionHeading String?
  page           KnowledgePage    @relation(fields: [pageId], references: [id], onDelete: Cascade)
  source         KnowledgeSource  @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  media          KnowledgeMedia[]

  @@index([sourceId])
  @@index([pageId])
  @@index([chunkIndex])
  @@map("knowledge_chunks")
}

model KnowledgeMedia {
  id           String          @id @default(cuid())
  pageId       String
  chunkId      String?
  type         String          @default("image")
  mediaUrl     String
  altText      String?
  caption      String?
  title        String?
  mimeType     String?
  width        Int?
  height       Int?
  metadata     Json?
  embedding    Float[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  page         KnowledgePage   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  chunk        KnowledgeChunk? @relation(fields: [chunkId], references: [id], onDelete: SetNull)

  @@index([pageId])
  @@index([chunkId])
  @@index([type])
  @@map("knowledge_media")
}

model KnowledgeSettings {
  id                  String   @id @default(cuid())
  chunkSize           Int      @default(500)
  chunkOverlap        Int      @default(50)
  similarityThreshold Float    @default(0.7)
  maxSearchResults    Int      @default(10)
  embeddingModel      String   @default("BAAI/bge-base-en-v1.5")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  llmModel            String   @default("Qwen/Qwen3-8B-Instruct")
  rerankerModel       String   @default("BAAI/bge-reranker-base")

  @@map("knowledge_settings")
}

model FAQ {
  id         String   @id @default(cuid())
  question   String
  answer     String
  status     String   @default("active")
  usageCount Int      @default(0)
  keywords   String[]
  category   String?
  priority   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status])
  @@index([category])
  @@index([priority])
  @@map("faqs")
}

model ChatSession {
  id        String        @id @default(cuid())
  userId    String
  title     String        @default("New Chat")
  status    String        @default("active")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]

  @@index([userId])
  @@index([status])
  @@map("chat_sessions")
}

model ChatMessage {
  id               String       @id @default(cuid())
  sessionId        String
  role             String
  content          String       @db.Text
  source           String?
  faqQuestion      String?
  faqId            String?
  relevanceScore   Float?
  supportingChunks Json?        @default("[]")
  totalRetrieved   Int?
  totalAfterRerank Int?
  images           Json?        @default("[]")
  createdAt        DateTime     @default(now())
  session          ChatSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([createdAt])
  @@map("chat_messages")
}

model ThemeSettings {
  id                     String   @id @default(cuid())
  primaryColor           String   @default("#2563eb")
  secondaryColor         String   @default("#0f172a")
  accentColor            String   @default("#14b8a6")
  successColor           String   @default("#10b981")
  warningColor           String   @default("#f59e0b")
  errorColor             String   @default("#ef4444")
  backgroundColor        String   @default("#f3f4f6")
  cardBackgroundColor    String   @default("#ffffff")
  sidebarBackgroundColor String   @default("#111827")
  headerBackgroundColor  String   @default("#ffffff")
  textColor              String   @default("#111827")
  borderColor            String   @default("#e5e7eb")
  primaryLogo            String?
  darkLogo               String?
  favicon                String?
  loginLogo              String?
  loginBackground        String?
  loginTitle             String?
  loginSubtitle          String?
  fontFamily             String   @default("Inter")
  fontScale              String   @default("1rem")
  headingWeight          String   @default("700")
  bodyWeight             String   @default("400")
  sidebarWidth           String   @default("16rem")
  borderRadius           String   @default("0.5rem")
  buttonRadius           String   @default("0.375rem")
  cardRadius             String   @default("0.5rem")
  compactMode            Boolean  @default(false)
  customCss              String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@map("theme_settings")
}

model WorkflowSettings {
  id        String   @id @default(cuid())
  type      String   @unique
  settings  String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("workflow_settings")
}

model WidgetSettings {
  id           String   @id @default(cuid())
  title        String   @default("AI Chat Assistant")
  welcomeText  String   @default("Hi! How can I help you today?")
  primaryColor String   @default("#2563eb")
  secondaryColor String @default("#1e293b")
  textColor    String   @default("#ffffff")
  bgColor      String   @default("#ffffff")
  position     String   @default("right")
  marginX      Int      @default(20)
  marginY      Int      @default(20)
  width        Int      @default(380)
  height       Int      @default(600)
  borderRadius Int      @default(16)
  showLogo     Boolean  @default(true)
  logoUrl      String?
  logoWidth    Int      @default(40)
  showAvatar   Boolean  @default(true)
  avatarUrl    String?
  avatarStyle  String   @default("rounded")
  bubbleStyle  String   @default("rounded")
  fontSize     String   @default("14px")
  headerBgColor String  @default("#2563eb")
  headerTextColor String @default("#ffffff")
  userMsgBgColor  String @default("#2563eb")
  userMsgTextColor String @default("#ffffff")
  botMsgBgColor   String @default("#f3f4f6")
  botMsgTextColor String @default("#111827")
  inputBgColor    String @default("#ffffff")
  inputBorderColor String @default("#e5e7eb")
  sendButtonColor String @default("#2563eb")
  sendIconColor   String @default("#ffffff")
  customCss       String?
  embedActive     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("widget_settings")
}
