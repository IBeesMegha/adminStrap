// ============================================================================
// STATIC CMS SCHEMA - DO NOT ADD DYNAMIC MODELS HERE
// ============================================================================
// This schema contains ONLY core CMS system tables.
// Dynamic content tables (Blog, News, etc.) are created at runtime via raw SQL.
// See lib/dynamic-table-service.ts for dynamic table management.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// CORE SYSTEM TABLES
// ============================================================================

// ============================================================================
// AUTHENTICATION TABLES
// ============================================================================

// User - Admin users who can access the CMS
model User {
  id        String    @id @default(cuid())
  email     String    @unique
  password  String    // bcrypt hashed password
  name      String
  roleId    String?
  role      Role?     @relation(fields: [roleId], references: [id], onDelete: SetNull)
  isActive  Boolean   @default(true)
  sessions  Session[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([roleId])
  @@map("users")
}

// Role - User roles with permissions
model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  slug        String           @unique
  description String?
  isSystem    Boolean          @default(false) // System roles cannot be deleted
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("roles")
}

// Permission - Granular permissions for actions
model Permission {
  id          String           @id @default(cuid())
  name        String           @unique
  slug        String           @unique // e.g., "users.create", "content.read"
  module      String           // e.g., "users", "content", "media"
  description String?
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([module])
  @@map("permissions")
}

// RolePermission - Many-to-many relationship between roles and permissions
model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

// Session - Stores refresh tokens for authenticated users
model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken String   @unique // hashed refresh token
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([refreshToken])
  @@map("sessions")
}

// ============================================================================
// CMS CONTENT TABLES
// ============================================================================

// Content Type Definitions - Stores metadata for dynamic collections
model CollectionType {
  id          String   @id @default(cuid())
  name        String   @unique
  displayName String
  description String?
  fields      Json     // Field definitions stored as JSON
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Single Type Definitions - Stores metadata and data for singleton content
// Now supports internationalization with translationGroupId and lang
model SingleType {
  id                 String   @id @default(cuid())
  name               String   // e.g., "home", "about"
  displayName        String
  description        String?
  fields             Json     // Field definitions stored as JSON
  data               Json?    // Actual content data stored as JSON
  translationGroupId String   // Groups translations of the same page
  lang               String   // Language code (e.g., "en", "fr")
  localeStatus       String   @default("published") // "draft" or "published"
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([name, lang]) // Each page can have one entry per language
  @@index([translationGroupId])
  @@index([lang])
}

// Component Definitions - Stores metadata for reusable components
model Component {
  id          String           @id @default(cuid())
  name        String           @unique
  displayName String
  category    String
  fields      Json             // Field definitions stored as JSON
  entries     ComponentEntry[] // Component instances
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

// Component Entries - Stores actual component data instances
model ComponentEntry {
  id          String    @id @default(cuid())
  componentId String
  component   Component @relation(fields: [componentId], references: [id], onDelete: Cascade)
  data        Json      // Component data stored as JSON
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([componentId])
  @@map("component_entries")
}

// Media Library - Stores uploaded media files metadata
model Media {
  id              String   @id @default(cuid())
  name            String
  alternativeText String?
  caption         String?
  url             String
  mime            String
  size            Int
  width           Int?
  height          Int?
  ext             String
  folder          String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("media")
}

// Language - Stores available languages for internationalization
model Language {
  id         String   @id @default(cuid())
  code       String   @unique // e.g., "en", "fr", "de"
  name       String   // e.g., "English", "French", "German"
  nativeName String?  // e.g., "English", "Français", "Deutsch"
  flag       String?  // e.g., "🇺🇸", "🇫🇷", "🇩🇪"
  isDefault  Boolean  @default(false)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("languages")
}

// ============================================================================
// KNOWLEDGE BASE TABLES
// ============================================================================

// KnowledgeSource - Stores knowledge sources like websites
model KnowledgeSource {
  id           String          @id @default(cuid())
  name         String
  websiteUrl   String          @unique
  status       String          @default("pending") // pending, crawling, completed, failed
  totalPages   Int             @default(0)
  lastCrawlAt  DateTime?
  errorMessage String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  pages        KnowledgePage[]

  @@map("knowledge_sources")
}

// KnowledgePage - Stores individual crawled pages
model KnowledgePage {
  id               String          @id @default(cuid())
  sourceId         String
  source           KnowledgeSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  url              String
  pageTitle        String?
  textContent      String          @db.Text
  htmlContent      String          @db.Text
  contentLength    Int             @default(0)
  crawlStatus      String          @default("discovered") // discovered, crawled, failed
  errorMessage     String?
  lastCrawledAt    DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([sourceId, url])
  @@index([sourceId])
  @@index([url])
  @@map("knowledge_pages")
}

// ============================================================================
// IMPORTANT: DO NOT ADD DYNAMIC CONTENT MODELS BELOW THIS LINE
// ============================================================================
// Dynamic content tables (Blog, News, Product, etc.) are managed at runtime.
// They are NOT part of this schema file.
// 
// To create a dynamic table:
//   1. Create a CollectionType via the admin UI or API
//   2. The system automatically creates the SQL table using raw queries
//   3. No Prisma model is generated
//   4. Query using lib/dynamic-prisma.ts functions
//
// This approach ensures:
//   ✓ Fresh clones don't recreate deleted content tables
//   ✓ Schema stays clean and maintainable
//   ✓ No migration conflicts from dynamic models
//   ✓ Prisma only manages core CMS infrastructure
// ============================================================================
